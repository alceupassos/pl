# Exemplo de configuração de variáveis de ambiente do projeto Sóstenes / Eleições 2026

# Autenticação e Sessão
AUTH_DISABLED=false
AUTH_LOGIN=admin
AUTH_PASSWORD=trocar_para_senha_segura
AUTH_COOKIE_NAME=sostenes_session
AUTH_JWT_SECRET=trocar_para_secret_jwt_secreto

# Proteção ALTCHA (captcha)
DISABLE_ALTCHA=false
ALTCHA_HMAC_SECRET=trocar_para_hmac_secret_unico

# WhatsApp & Integrador WhatsGate
WHATSGATE_BASE_URL=https://whatsgate.angra.io
WHATSGATE_API_KEY=sua_api_key_whatsgate
WHATSGATE_SESSION_ID=51742fb1
WHATSGATE_TOKEN=seu_token_webhook
WHATSGATE_WEBHOOK_TOKEN=seu_token_inbound
CAMPANHA_WHATSAPP=5511916870066
ACCESS_WHATSAPP_TO=5511916870066

# Cobrança por IA & Agendamento
COBRANCA_CRON_TOKEN=token_secreto_para_cron_cobranca

# Provedores de Inteligência Artificial
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=sua_chave_deepseek
DEEPSEEK_MODEL_CHAT=deepseek-chat
OPENAI_API_KEY=sua_chave_openai
GROK_API_KEY=sua_chave_grok
GEMINI_API_KEY=sua_chave_gemini

# Microserviço de Sentimento / Sidecar Python
SENTIMENT_URL=http://localhost:8000

# Push Notifications (WebPush / VAPID)
VAPID_PUBLIC_KEY=sua_vapid_public_key
VAPID_PRIVATE_KEY=sua_vapid_private_key
VAPID_SUBJECT=mailto:admin@angra.io
